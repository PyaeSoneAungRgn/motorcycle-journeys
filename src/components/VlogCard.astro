---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  title: string;
  episode: number;
  duration: string;
  location: string;
  poster: ImageMetadata;
}
const { href, title, episode, duration, location, poster } = Astro.props;
---

<a class="vlog-card" href={href}>
  <span class="vlog-card__media">
    <Image
      src={poster}
      alt={`Still from “${title}”`}
      widths={[480, 800, 1200]}
      sizes="(max-width: 640px) 92vw, (max-width: 1080px) 45vw, 30vw"
      loading="lazy"
      decoding="async"
    />
    <span class="vlog-card__play" aria-hidden="true">
      <svg viewBox="0 0 8 10" fill="currentColor" aria-hidden="true">
        <path d="M0 0l8 5-8 5z" />
      </svg>
      Film
    </span>
    <span class="vlog-card__duration">{duration}</span>
  </span>
  <span class="vlog-card__body">
    <span class="vlog-card__kicker">
      <span>Ep. {String(episode).padStart(2, '0')}</span>
      <span>{location}</span>
    </span>
    <span class="vlog-card__title">{title}</span>
  </span>
</a>
