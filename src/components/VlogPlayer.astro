---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  youtubeId: string;
  title: string;
  duration: string;
  episode: number;
  poster: ImageMetadata;
}
const { youtubeId, title, duration, episode, poster } = Astro.props;
---

<div class="player" data-player data-video-id={youtubeId} data-video-title={title}>
  <Image
    src={poster}
    alt={`Still from “${title}”`}
    widths={[800, 1200, 1600]}
    sizes="(max-width: 1080px) 92vw, 78vw"
    loading="lazy"
    decoding="async"
  />
  <button class="player__button" type="button" data-play aria-label={`Play film: ${title}`}>
    <span class="player__play" aria-hidden="true">
      <svg viewBox="0 0 12 14" fill="currentColor" aria-hidden="true">
        <path d="M0 0l12 7-12 7z" />
      </svg>
    </span>
    <span class="player__label">Play film · Ep. {String(episode).padStart(2, '0')}</span>
    <span class="player__duration">{duration}</span>
  </button>
  <noscript>
    <p class="player-noscript">
      <a href={`https://www.youtube.com/watch?v=${youtubeId}`}>Watch this film on YouTube</a>
    </p>
  </noscript>
</div>
