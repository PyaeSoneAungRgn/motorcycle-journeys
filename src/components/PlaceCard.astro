---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  title: string;
  location: string;
  year: number;
  duration: string;
  summary: string;
  poster: ImageMetadata;
}
const { href, title, location, year, duration, summary, poster } = Astro.props;
---

<a class="place-card" href={href} target="_blank" rel="noopener">
  <span class="place-card__media">
    <Image
      src={poster}
      alt={`Still from “${title}”`}
      widths={[480, 800, 1200]}
      sizes="(max-width: 640px) 92vw, (max-width: 820px) 46vw, 30vw"
      loading="lazy"
      decoding="async"
    />
    <span class="place-card__play" aria-hidden="true">
      <svg viewBox="0 0 8 10" fill="currentColor" aria-hidden="true">
        <path d="M0 0l8 5-8 5z" />
      </svg>
      Film
    </span>
    <span class="place-card__external" aria-hidden="true">↗</span>
    <span class="place-card__duration">{duration}</span>
  </span>
  <span class="place-card__body">
    <span class="place-card__kicker">
      <span>{location}</span>
      <span>{year}</span>
    </span>
    <span class="place-card__title">
      {title}<span class="visually-hidden"> (opens on YouTube in a new tab)</span>
    </span>
    <span class="place-card__note">{summary}</span>
  </span>
</a>
