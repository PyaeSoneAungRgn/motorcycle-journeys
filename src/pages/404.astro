---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="This road does not exist." noindex>
  <section class="not-found shell">
    <div class="not-found__inner">
      <p class="not-found__code">Error 404</p>
      <h1>Wrong turn.</h1>
      <p>This road does not exist — or it has been quietly taken off the map.</p>
      <a class="btn btn--solid" href="/">
        Back to the start <span class="btn__arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Base>
